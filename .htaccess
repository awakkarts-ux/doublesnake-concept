# даблснейк.рф — Apache 2.2 (SpaceWeb)

# своя страница «не найдено»
ErrorDocument 404 /404.html

RewriteEngine On

# http → https (и сразу без www). X-Forwarded-Proto — на случай, если https принимает прокси перед Apache:
# без этой проверки за прокси получился бы бесконечный редирект
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# https://www.даблснейк.рф → https://даблснейк.рф (один адрес для поисковиков)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
